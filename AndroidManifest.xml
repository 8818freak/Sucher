<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.herbers.sucher"
    android:versionCode="19"
    android:versionName="0.19">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Datei-Volltextsuche braucht rohen Dateisystemzugriff (nicht nur
         MediaStore-bekannte Medientypen) - optional, erst bei Bedarf ueber
         einen eigenen System-Bildschirm erteilt (siehe MainActivity.
         permissionHint), kein normaler Laufzeit-Dialog. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Kontakte/Termine mitdurchsuchen - optional, wie die Dateisuche erst
         bei Bedarf angefragt (siehe MainActivity.requestPimPermissions). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Ohne das waeren seit Android 11 (Package-Visibility) fuer
         queryIntentActivities() praktisch alle Fremd-Apps unsichtbar - genau
         das liess die Benachrichtigungsquellen-Liste auf nur die schon
         beobachteten Apps zusammenschrumpfen (Mathias' Meldung "sieht aus
         wie vorher"). EdgeTab hat diesen Block schon, hier fehlte er. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/SucherTheme"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Grosse Vorschau (Quick-Look-Gefuehl) beim Antippen einer
             Miniatur - siehe PreviewActivity. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@style/SucherTheme" />

        <!-- Reicht gefundene Dateien an die zustaendige App weiter (eigener
             schlanker Ersatz fuer androidx.core.content.FileProvider) -->
        <provider
            android:name=".LocalFileProvider"
            android:authorities="de.herbers.sucher.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Schneidet Systembenachrichtigungen mit, um Chats/Mails/Messenger
             wenigstens teilweise durchsuchbar zu machen (siehe
             NotificationCapture) - optional, eigener Freigabe-Bildschirm. -->
        <service
            android:name=".NotificationCapture"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Regelmaessiger Hintergrund-Abgleich des Index (siehe
             IndexJobService) - ueber JobScheduler statt Dauer-Dienst. -->
        <service
            android:name=".IndexJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
